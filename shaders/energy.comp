#version 460 core
layout(local_size_x = 16, local_size_y = 16) in;

#include "common.glsl"

// The global objective from Hertzmann 2001:
//
//   E_app = sum over pixels of || Lab(canvas) - Lab(source) ||
//
// relax.comp scores trial moves on each stroke's own footprint, which is an
// approximation (see the comment there). This reduction is the real thing, and
// exists so relaxation can be checked rather than believed: the reported energy
// should fall on every iteration. If it ever rises, the local score and the
// global objective have come apart and the move set is at fault.
//
// One partial sum per workgroup, summed on the host -- a 1920x1080 frame gives
// 8160 partials, which is a trivial readback next to a second reduction pass.
// It is only issued when the caller asks for the number.

layout(binding = 0) uniform sampler2D uSrc;
layout(binding = 1) uniform sampler2D uCanvas;

layout(std430, binding = 9) restrict writeonly buffer EnergyBuf { float partial[]; };

shared float sTile[256];

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(IMG_SIZE);
    uint lid = gl_LocalInvocationIndex;

    float e = 0.0;
    if (px.x < size.x && px.y < size.y) {
        vec3 I = clamp(texelFetch(uSrc, px, 0).rgb, 0.0, 1.0);
        vec3 C = clamp(texelFetch(uCanvas, px, 0).rgb, 0.0, 1.0);
        e = distance(rgb2labCV(I), rgb2labCV(C));
    }
    sTile[lid] = e;
    barrier();

    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (lid < s) sTile[lid] += sTile[lid + s];
        barrier();
    }

    if (lid == 0u) {
        uint groups = uint(gl_NumWorkGroups.x);
        partial[gl_WorkGroupID.y * groups + gl_WorkGroupID.x] = sTile[0];
    }
}
